cmake_minimum_required(VERSION 3.22
project(ExtasisRhythm VERSION 1.0.0 LANGUAGES C CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# --------------------------------------------------
# macOS
# --------------------------------------------------

set(CMAKE_OSX_DEPLOYMENT_TARGET "11.0" CACHE STRING "Minimum macOS version")

# --------------------------------------------------
# JUCE
# --------------------------------------------------

if(NOT DEFINED JUCE_PATH)
    message(FATAL_ERROR "JUCE_PATH is not defined")
endif()

add_subdirectory(
    "${JUCE_PATH}"
    "${CMAKE_BINARY_DIR}/JUCE"
)

# --------------------------------------------------
# Plugin
# ---------------

    COMPANY_NAME "Extasis Records"

    BUNDLE_ID
        "com.extasisrecords.extasisrhythm"

    PLUGIN_MANUFACTURER_CODE ExRs
    PLUGIN_CODE ExRh

    PRODUCT_NAME "ExtasisRhythm"

    VERSION 1.0.0

    FORMATS
        VST3
        Standalone

    IS_SYNTH TRUE

    NEEDS_MIDI_INPUT TRUE
    NEEDS_MIDI_OUTPUT FALSE

    IS_MIDI_EFFECT FALSE

    COPY_PLUGIN_AFTER_BUILD FALSE

    VST3_CATEGORIES "Instrument"
)

# --------------------------------------------------
# Sources
# --------------------------------------------------

target_sources(ExtasisRhythm PRIVATE

    src/PluginProcessor.cpp
    src/PluginProcessor.h

    src/PluginEditor.cpp
    src/PluginEditor.h
)

# --------------------------------------------------
# JUCE configuration
# --------------------------------------------------

target_compile_definitions(
    ExtasisRhythm
    PRIVATE

    JUCE_WEB_BROWSER=0
    JUCE_USE_CURL=0
    JUCE_DISPLAY_SPLASH_SCREEN=0
    JUCE_VST3_CAN_REPLACE_VST2=0
)

# --------------------------------------------------
# JUCE modules
# --------------------------------------------------

target_link_libraries(
    ExtasisRhythm
    PRIVATE

    juce::juce_audio_utils
    juce::juce_audio_formats
    juce::juce_dsp
    juce::juce_gui_extra

    juce::juce_recommended_config_flags
    juce::juce_recommended_warning_flags
)
